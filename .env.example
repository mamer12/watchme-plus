# TMDB credential used only by the serverless proxy (api/tmdb.ts). Never exposed to the browser.
# Either a v3 API key or a v4 "API Read Access Token" (starts with eyJ).
TMDB_KEY=

# Cross-device sync (optional). Public values only: the Supabase Project URL and the anon / publishable key.
# Without both, the Sync section is hidden and no sync code loads. NEVER put the service_role key or a database
# password here. Setup: supabase/README.md.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
